# ---- Slack ----
SLACK_WEBHOOK_URL=

# ---- Bitbucket ----
BITBUCKET_WORKSPACE=techcore
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
# Optional: only these repo slugs (comma separated). Empty = every repo in the workspace.
BITBUCKET_REPOS=
# Optional: only notify for these branches (comma separated). Empty = all branches.
BITBUCKET_NOTIFY_BRANCHES=
# Optional @mentions: "Bitbucket display name:SlackMemberID", comma separated
SLACK_USERS=
# What to announce (remove any you do not want)
POLL_EVENTS=pr,commits,branches,comments,approvals,reviewers,pipelines

# ---- Security: secret used to call /api/poll ----
POLL_KEY=put-a-long-random-text-here

# ---- Storage (Upstash Redis, added from the Vercel Storage tab) ----
# Vercel sets these for you when you connect the database:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
